import { useState, useEffect, useMemo, useCallback } from 'react'
import { supabase } from '../lib/supabase'

export function useOrders() {
  const [orders, setOrders] = useState([])
  const [loading, setLoading] = useState(true)

  const [statusFilter, setStatusFilter] = useState('all')
  const [paymentFilter, setPaymentFilter] = useState('all')
  const [dateRange, setDateRange] = useState('all')
  const [searchQuery, setSearchQuery] = useState('')
  const [sortBy, setSortBy] = useState('date')
  const [sortDir, setSortDir] = useState('desc')

  const fetchOrders = useCallback(async () => {
    setLoading(true)
    const { data, error } = await supabase
      .from('orders')
      .select(`
        *,
        order_items(
          *,
          products(
            product_id,
            item_name,
            image_url,
            color,
            flower_type,
            category,
            description
          )
        )
      `)
      .order('created_at', { ascending: false })

    if (error) {
      console.error('Error fetching orders:', error)
    } else {
      setOrders(data || [])
    }
    setLoading(false)
  }, [])

  useEffect(() => {
    fetchOrders()
  }, [fetchOrders])

  const filteredOrders = useMemo(() => {
    let result = [...orders]

    if (searchQuery.trim()) {
      const q = searchQuery.toLowerCase().trim()
      result = result.filter(o =>
        o.client_name?.toLowerCase().includes(q) ||
        o.order_number?.toLowerCase().includes(q) ||
        o.client_phone?.includes(q)
      )
    }

    if (statusFilter !== 'all') {
      result = result.filter(o => o.status === statusFilter)
    }

    if (paymentFilter !== 'all') {
      result = result.filter(o => o.payment_status === paymentFilter)
    }

    if (dateRange !== 'all') {
      const now = new Date()
      result = result.filter(o => {
        const d = new Date(o.created_at)
        if (dateRange === 'today') return d.toDateString() === now.toDateString()
        if (dateRange === 'week') return (now - d) < 7 * 86400000
        if (dateRange === 'month') return (now - d) < 30 * 86400000
        return true
      })
    }

    result.sort((a, b) => {
      let cmp = 0
      if (sortBy === 'date') cmp = new Date(b.created_at) - new Date(a.created_at)
      if (sortBy === 'amount') cmp = (b.total_amount || 0) - (a.total_amount || 0)
      if (sortBy === 'status') cmp = (a.status || '').localeCompare(b.status || '')
      return sortDir === 'asc' ? -cmp : cmp
    })

    return result
  }, [orders, searchQuery, statusFilter, paymentFilter, dateRange, sortBy, sortDir])

  const stats = useMemo(() => {
    const todayStr = new Date().toISOString().split('T')[0]
    const todayOrders = orders.filter(o => o.created_at?.startsWith(todayStr))

    const paidOrders = orders.filter(o => o.payment_status === 'paid')
    const unpaidOrders = orders.filter(o => o.payment_status === 'unpaid' || o.payment_status === 'partial')

    const totalRevenue = paidOrders.reduce((s, o) => s + (o.total_amount || 0), 0)
    const todayRevenue = todayOrders.reduce((s, o) => s + (o.total_amount || 0), 0)

    const outstanding = unpaidOrders.reduce((s, o) => {
      const due = o.amount_due ?? (o.total_amount - (o.amount_paid || 0))
      return s + Math.max(0, due || 0)
    }, 0)

    return {
      total: orders.length,
      today: todayOrders.length,
      pending: orders.filter(o => o.status === 'new' || o.status === 'processing').length,
      done: orders.filter(o => o.status === 'done').length,
      cancelled: orders.filter(o => o.status === 'cancelled').length,
      paid: paidOrders.length,
      unpaid: unpaidOrders.length,
      totalRevenue,
      todayRevenue,
      outstanding,
    }
  }, [orders])

  const statusCounts = useMemo(() => ({
    all: orders.length,
    new: orders.filter(o => o.status === 'new').length,
    processing: orders.filter(o => o.status === 'processing').length,
    done: orders.filter(o => o.status === 'done').length,
    cancelled: orders.filter(o => o.status === 'cancelled').length,
  }), [orders])

  const paymentCounts = useMemo(() => ({
    all: orders.length,
    paid: orders.filter(o => o.payment_status === 'paid').length,
    partial: orders.filter(o => o.payment_status === 'partial').length,
    unpaid: orders.filter(o => o.payment_status === 'unpaid').length,
    refunded: orders.filter(o => o.payment_status === 'refunded').length,
  }), [orders])

  const adjustStockForItems = async (items, direction) => {
    for (const item of items || []) {
      if (!item.product_id) continue
      const { data: product } = await supabase
        .from('products')
        .select('stock_level')
        .eq('product_id', item.product_id)
        .single()

      if (!product) continue

      const delta = direction === 'deduct' ? -item.quantity : item.quantity
      const newStock = Math.max(0, product.stock_level + delta)

      const { error } = await supabase
        .from('products')
        .update({ stock_level: newStock })
        .eq('product_id', item.product_id)

      if (error) console.error(`Stock update failed for product ${item.product_id}:`, error)
    }
  }

  const updateStatus = useCallback(async (orderId, newStatus) => {
    try {
      const { data: order, error: fetchErr } = await supabase
        .from('orders')
        .select('status, order_items(product_id, quantity)')
        .eq('id', orderId)
        .single()

      if (fetchErr) throw fetchErr

      const wasDone = order.status === 'done'
      const isDone = newStatus === 'done'

      if (!wasDone && isDone) {
        await adjustStockForItems(order.order_items, 'deduct')
      } else if (wasDone && !isDone) {
        await adjustStockForItems(order.order_items, 'restore')
      }

      const { error } = await supabase
        .from('orders')
        .update({ status: newStatus })
        .eq('id', orderId)

      if (error) throw error
      await fetchOrders()
      return true
    } catch (err) {
      console.error('Error updating status:', err)
      return false
    }
  }, [fetchOrders])

  const updatePaymentStatus = useCallback(async (orderId, paymentStatus, amountPaid, notes = '') => {
    const order = orders.find(o => o.id === orderId)
    if (!order) return false

    const clampedAmountPaid = Math.min(amountPaid, order.total_amount)
    const amountDue = Math.max(0, order.total_amount - clampedAmountPaid)

    const { error } = await supabase
      .from('orders')
      .update({
        payment_status: paymentStatus,
        amount_paid: clampedAmountPaid,
        amount_due: amountDue,
        payment_notes: notes,
      })
      .eq('id', orderId)

    if (error) {
      console.error('Error updating payment:', error)
      return false
    }
    await fetchOrders()
    return true
  }, [orders, fetchOrders])

  const markAsPaid = useCallback(async (orderId) => {
    const order = orders.find(o => o.id === orderId)
    if (!order) return false
    if (order.payment_status === 'paid') return true

    return updatePaymentStatus(orderId, 'paid', order.total_amount, 'Full payment received')
  }, [orders, updatePaymentStatus])

  const recordPartialPayment = useCallback(async (orderId, amount, notes = '') => {
    const order = orders.find(o => o.id === orderId)
    if (!order) return false

    const currentPaid = order.amount_paid || 0
    const newAmountPaid = currentPaid + amount

    const clampedAmountPaid = Math.min(newAmountPaid, order.total_amount)
    const status = clampedAmountPaid >= order.total_amount ? 'paid' : 'partial'

    return updatePaymentStatus(orderId, status, clampedAmountPaid, notes)
  }, [orders, updatePaymentStatus])

  const recordRefund = useCallback(async (orderId, refundAmount, notes = '') => {
    try {
      const { data: order, error: fetchErr } = await supabase
        .from('orders')
        .select('total_amount, amount_paid')
        .eq('id', orderId)
        .single()

      if (fetchErr) throw fetchErr

      const currentPaid = order.amount_paid || 0
      const newAmountPaid = Math.max(0, currentPaid - refundAmount)
      const newAmountDue = order.total_amount - newAmountPaid
      const paymentStatus = newAmountPaid === 0 ? 'refunded' : newAmountPaid >= order.total_amount ? 'paid' : 'partial'

      const { error } = await supabase
        .from('orders')
        .update({
          payment_status: paymentStatus,
          amount_paid: newAmountPaid,
          amount_due: newAmountDue,
          payment_notes: notes,
        })
        .eq('id', orderId)

      if (error) throw error
      await fetchOrders()
      return true
    } catch (err) {
      console.error('Error recording refund:', err)
      return false
    }
  }, [fetchOrders])

  const deleteOrder = useCallback(async (orderId) => {
    try {
      const { data: order, error: fetchErr } = await supabase
        .from('orders')
        .select('status, order_items(product_id, quantity)')
        .eq('id', orderId)
        .single()

      if (fetchErr) throw fetchErr

      if (order?.status === 'done') {
        await adjustStockForItems(order.order_items, 'restore')
      }

      const { error } = await supabase.from('orders').delete().eq('id', orderId)
      if (error) throw error
      await fetchOrders()
      return true
    } catch (err) {
      console.error('Error deleting order:', err)
      return false
    }
  }, [fetchOrders])

  // ─────────────────────────────────────────────────────────────
  // FIXED: updateOrder — sanitizes empty dates to null & better errors
  // ─────────────────────────────────────────────────────────────
  const updateOrder = useCallback(async (orderId, { orderData, itemUpdates }) => {
    try {
      const { data: currentOrder, error: fetchErr } = await supabase
        .from('orders')
        .select('*, order_items(*)')
        .eq('id', orderId)
        .single()

      if (fetchErr) {
        console.error('Fetch current order failed:', fetchErr)
        throw fetchErr
      }

      // Sanitize payload: empty strings → null for date fields
      let finalOrderData = { ...orderData }
      if (finalOrderData.delivery_date === '') finalOrderData.delivery_date = null
      if (finalOrderData.client_phone === '') finalOrderData.client_phone = null

      if (itemUpdates && itemUpdates.length > 0) {
        const currentItems = currentOrder.order_items || []
        const itemsToRestore = []
        const itemsToDeduct = []

        for (const update of itemUpdates) {
          const currentItem = currentItems.find(i => i.id === update.id)
          if (!currentItem) continue

          if (update.deleted) {
            const { error: delErr } = await supabase
              .from('order_items')
              .delete()
              .eq('id', update.id)
            if (delErr) {
              console.error('Delete item failed:', delErr)
              throw delErr
            }

            if (currentOrder.status === 'done') {
              itemsToRestore.push({ product_id: currentItem.product_id, quantity: currentItem.quantity })
            }
          } else if (update.quantity !== currentItem.quantity) {
            const newTotalPrice = update.quantity * currentItem.unit_price
            const { error: updErr } = await supabase
              .from('order_items')
              .update({ quantity: update.quantity, total_price: newTotalPrice })
              .eq('id', update.id)
            if (updErr) {
              console.error('Update item failed:', updErr)
              throw updErr
            }

            if (currentOrder.status === 'done') {
              const delta = update.quantity - currentItem.quantity
              if (delta > 0) {
                itemsToDeduct.push({ product_id: currentItem.product_id, quantity: delta })
              } else if (delta < 0) {
                itemsToRestore.push({ product_id: currentItem.product_id, quantity: Math.abs(delta) })
              }
            }
          }
        }

        if (itemsToRestore.length > 0) await adjustStockForItems(itemsToRestore, 'restore')
        if (itemsToDeduct.length > 0) await adjustStockForItems(itemsToDeduct, 'deduct')

        const { data: remainingItems, error: remErr } = await supabase
          .from('order_items')
          .select('*')
          .eq('order_id', orderId)

        if (remErr) {
          console.error('Fetch remaining items failed:', remErr)
          throw remErr
        }

        const newSubtotal = remainingItems.reduce((sum, item) => sum + (item.total_price || 0), 0)
        finalOrderData.subtotal_amount = newSubtotal
        finalOrderData.total_amount = newSubtotal
        finalOrderData.amount_due = Math.max(0, newSubtotal - (currentOrder.amount_paid || 0))

        const paid = currentOrder.amount_paid || 0
        if (paid >= newSubtotal && paid > 0) {
          finalOrderData.payment_status = 'paid'
        } else if (paid > 0 && paid < newSubtotal) {
          finalOrderData.payment_status = 'partial'
        } else if (paid === 0) {
          finalOrderData.payment_status = 'unpaid'
        }
      }

      const { error: updErr } = await supabase
        .from('orders')
        .update(finalOrderData)
        .eq('id', orderId)

      if (updErr) {
        console.error('Update order failed:', updErr)
        throw updErr
      }

      await fetchOrders()
      return true
    } catch (err) {
      console.error('Error updating order:', err)
      return false
    }
  }, [fetchOrders])

  const toggleSort = useCallback((field) => {
    setSortBy(prev => {
      if (prev === field) {
        setSortDir(d => d === 'asc' ? 'desc' : 'asc')
        return prev
      }
      setSortDir('desc')
      return field
    })
  }, [])

  return {
    orders: filteredOrders,
    allOrders: orders,
    loading,
    statusFilter, setStatusFilter,
    paymentFilter, setPaymentFilter,
    dateRange, setDateRange,
    searchQuery, setSearchQuery,
    sortBy, sortDir,
    stats,
    statusCounts,
    paymentCounts,
    updateStatus,
    updatePaymentStatus,
    markAsPaid,
    recordPartialPayment,
    recordRefund,
    deleteOrder,
    updateOrder,
    refresh: fetchOrders,
    toggleSort,
  }
}