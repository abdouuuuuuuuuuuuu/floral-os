# Create a named Cloudflare Tunnel and route its public hostname to http://caddy:8080.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-named-tunnel-token

# Generate with: openssl rand -hex 32
# Use this same value as Supabase's ROUTING_SERVICE_API_KEY secret.
ROUTER_API_TOKEN=replace-with-a-random-64-character-hex-token
